{
  "name": "responsibility-driven-backend",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "start:dev": "tsc --watch --project tsconfig.json",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "format": "prettier --write src test scripts *.json *.mjs",
    "lint": "eslint src test",
    "format:check": "prettier --check src test scripts *.json *.mjs",
    "test:health": "node scripts/health-smoke.cjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm test:health",
    "start:watch": "node --watch dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.15.30",
    "eslint": "10.11.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "22.23.4",
    "pnpm": "10.13.1"
  },
  "pnpm": {
    "overrides": {
      "qs": "6.16.1",
      "multer": "2.5.0",
      "minimatch": "11.0.1"
    }
  }
}
